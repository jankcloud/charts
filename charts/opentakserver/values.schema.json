{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "image": {
      "type": "object",
      "properties": {
        "repository": {"type": "string"},
        "pullPolicy": {"type": "string", "enum": ["Always", "IfNotPresent", "Never"]},
        "tag": {"type": "string"}
      },
      "additionalProperties": true
    },
    "imagePullSecrets": {"type": "array"},
    "nameOverride": {"type": "string"},
    "fullnameOverride": {"type": "string"},
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": {"type": "boolean"},
        "automount": {"type": "boolean"},
        "annotations": {"type": "object"},
        "name": {"type": "string"}
      },
      "additionalProperties": true
    },
    "podSecurityContext": {"type": "object"},
    "securityContext": {"type": "object"},
    "env": {
      "type": "object",
      "properties": {
        "OTS_DATA_FOLDER": {"type": "string"},
        "OTS_LISTENER_ADDRESS": {"type": "string"},
        "OTS_LISTENER_PORT": {"type": "string"},
        "OTS_STREAMING_INTERFACE": {"type": "string"},
        "OTS_TCP_STREAMING_PORT": {"type": "string"},
        "OTS_SSL_STREAMING_PORT": {"type": "string"},
        "OTS_UDP_PORT": {"type": "string"}
      },
      "additionalProperties": true
    },
    "web": {
      "$ref": "#/definitions/component",
      "properties": {
        "service": {
          "type": "object",
          "properties": {
            "enabled": {"type": "boolean"},
            "type": {"type": "string"},
            "annotations": {"type": "object"},
            "ports": {"type": "object"}
          },
          "additionalProperties": true
        },
        "ingress": {"type": "object"},
        "httpRoute": {"type": "object"}
      }
    },
    "eudHandler": {
      "$ref": "#/definitions/component",
      "properties": {
        "mode": {"type": "string", "enum": ["tcp", "ssl", "udp"]},
        "service": {
          "type": "object",
          "properties": {
            "enabled": {"type": "boolean"},
            "type": {"type": "string"},
            "annotations": {"type": "object"},
            "ports": {"type": "object"}
          },
          "additionalProperties": true
        }
      }
    },
    "cotParser": {
      "$ref": "#/definitions/component",
      "properties": {
        "processes": {"type": "integer", "minimum": 1},
        "prefetch": {"type": "integer", "minimum": 1}
      }
    },
    "persistence": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "existingClaim": {"type": "string"},
        "mountPath": {"type": "string"},
        "accessModes": {"type": "array"},
        "size": {"type": "string"},
        "storageClass": {"type": "string"}
      },
      "additionalProperties": true
    },
    "database": {
      "type": "object",
      "properties": {
        "uri": {"type": "string"},
        "existingSecret": {"type": "object"},
        "host": {"type": "string"},
        "port": {"type": "string"},
        "database": {"type": "string"},
        "username": {"type": "string"},
        "password": {"type": "string"}
      },
      "additionalProperties": true
    },
    "postgresql": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "auth": {"type": "object"},
        "primary": {"type": "object"}
      },
      "additionalProperties": true
    },
    "rabbitmq": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "replicaCount": {"type": "integer", "minimum": 1},
        "clustering": {"type": "object"},
        "auth": {"type": "object"},
        "persistence": {"type": "object"},
        "external": {"type": "object"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true,
  "definitions": {
    "component": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "replicaCount": {"type": "integer", "minimum": 0},
        "serviceAccountName": {"type": "string"},
        "podSecurityContext": {"type": "object"},
        "securityContext": {"type": "object"},
        "imagePullSecrets": {"type": "array"},
        "podAnnotations": {"type": "object"},
        "podLabels": {"type": "object"},
        "extraEnv": {"type": "array"},
        "envFrom": {"type": "array"},
        "volumes": {"type": "array"},
        "volumeMounts": {"type": "array"},
        "nodeSelector": {"type": "object"},
        "tolerations": {"type": "array"},
        "affinity": {"type": "object"},
        "autoscaling": {
          "type": "object",
          "properties": {
            "enabled": {"type": "boolean"},
            "minReplicas": {"type": "integer", "minimum": 1},
            "maxReplicas": {"type": "integer", "minimum": 1},
            "targetCPUUtilizationPercentage": {"type": ["integer", "string"]},
            "targetMemoryUtilizationPercentage": {"type": ["integer", "string"]}
          },
          "additionalProperties": true
        },
        "resources": {"type": "object"},
        "livenessProbe": {"type": "object"},
        "readinessProbe": {"type": "object"},
        "startupProbe": {"type": "object"}
      },
      "additionalProperties": true
    }
  }
}
